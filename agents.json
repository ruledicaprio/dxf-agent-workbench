{
  "agent": {
    "name": "dxf-agent-workbench",
    "version": "0.1.0",
    "description": "Orthographic DXF renderer",
    "capabilities": ["dxf-to-png", "dxf-to-dxf-wireframe", "dxf-to-outline"],
    "entry": "dxf_agent.export.orthographic:main",
    "cli": "dxf-ortho",
    "mcp": {
      "entry": "dxf_agent.mcp.server:main",
      "command": "dxf-ortho-mcp",
      "install_extra": "mcp",
      "transport": "stdio",
      "tools": ["render_orthographic_views"]
    },
    "license": "MIT"
  }
}
